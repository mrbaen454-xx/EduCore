APP_ENV=development
APP_PORT=8080
APP_TIMEZONE=Asia/Jakarta
LOG_LEVEL=info

HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=educore
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_SSLMODE=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m
DB_CONNECT_TIMEOUT=5s
DB_HEALTH_TIMEOUT=2s

# Authentication & JWT Configuration (Fase 05)
# JWT_SECRET harus memiliki panjang minimal 32 karakter (256-bit entropy)
JWT_SECRET=your_super_secret_signing_key_min_32_chars_long_placeholder
JWT_ISSUER=educore-auth
JWT_AUDIENCE=educore-api
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=168h

# Argon2id Password Hashing Parameters (RFC 9106 recommended profile)
ARGON2_MEMORY=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=4
ARGON2_SALT_LENGTH=16
ARGON2_KEY_LENGTH=32
